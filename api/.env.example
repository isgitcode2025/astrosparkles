# ---- Server ----
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
WEB_URL=http://localhost:3000
MONGO_URI=mongodb://localhost:27017/kundlijano
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# ---- White-label brand (change per client) ----
BRAND_NAME=AstroSparkles
BRAND_TAGLINE=Vedic astrology, kundli and live consultations
BRAND_LOGO_URL=/brand/logo.svg
BRAND_LOGO_MARK_URL=/brand/logo-mark.svg
BRAND_COLOR_PRIMARY=#3B1F6E
BRAND_COLOR_PRIMARY_DARK=#24124A
BRAND_COLOR_ACCENT=#E8912D
BRAND_COLOR_GOLD=#D4A93C
BRAND_COLOR_BG=#FFF9F0
BRAND_COLOR_TEXT=#1E1630
BRAND_FONT_HEADING=Poppins
BRAND_FONT_BODY=Mukta
BRAND_SUPPORT_EMAIL=support@example.com
BRAND_SUPPORT_PHONE=
BRAND_WHATSAPP=
BRAND_LANGUAGES=en,hi
BRAND_DEFAULT_LANGUAGE=en
BRAND_CURRENCY=INR
# Optional home page / header extras (uncomment to override the defaults)
# BRAND_SHORT_TAGLINE=Vedic Astrology & Live Consultations
# BRAND_ANNOUNCEMENT=New here? Your first chat with any astrologer is free for 5 minutes.   (set empty to hide the strip)
# BRAND_ANNOUNCEMENT_LABEL=Welcome offer
# BRAND_APP_ANDROID_URL=
# BRAND_APP_IOS_URL=
# BRAND_SOCIAL_FACEBOOK=
# BRAND_SOCIAL_INSTAGRAM=
# BRAND_SOCIAL_YOUTUBE=
# BRAND_SOCIAL_X=

# ---- Payments (Razorpay test keys during development) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Calls (Agora) ----
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ---- Astrology data provider ----
ASTRO_API_PROVIDER=navamsha
ASTRO_API_BASE_URL=https://api.navamsha.in/api/v1
# Never commit the real key. Put it only in api/.env
ASTRO_API_KEY=
ASTRO_AYANAMSHA=lahiri
ASTRO_API_TIMEOUT_MS=15000
ASTRO_CACHE_DAYS=30

# ---- OTP login ----
# console = code printed in API logs (dev). msg91 = real SMS.
OTP_PROVIDER=console
OTP_DEV_FIXED_CODE=123456
OTP_TTL_SECONDS=300
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---- Google sign-in (comma-separated OAuth client IDs: web, android, ios) ----
# Google sign-in: comma-separated OAuth client ids; put the WEB client id first (the website's Google button uses it)
GOOGLE_CLIENT_IDS=

# ---- Wallet ----
WALLET_GST_PERCENT=18
WALLET_MIN_RECHARGE=50
WALLET_MAX_RECHARGE=100000
# amount:bonusPercent pairs
WALLET_PACKS=100:0,200:0,500:5,1000:10,2000:10,5000:15

# ---- Consultations ----
CONSULT_FREE_MINUTES=5
CONSULT_MIN_BALANCE_MINUTES=5
CONSULT_REQUEST_TIMEOUT_SECONDS=60
